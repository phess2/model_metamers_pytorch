{
    "model_name": "lipsalexnet",
    "hparams": {
        "num_classes": 1000,
        "w_max": 9.0,
        "projection": "spectral_normalize",
        "max_epochs": 5,
        "val_check_interval": 0.25
    },
    "data_settings": {
        "batch_size": 512,
        "pin_memory": false
    },
    "optim_settings": {
        "mult_optimizers": false,
        "optimizer": {"name": "AdamW", 
            "kwargs": {
                "lr": 0.0001,
                "betas": [0.9, 0.999],
                "eps": 1e-8,
                "weight_decay": 0.01
            },
            "lr_scheduler": {
                "name": "SequentialLR",
                "interval": "step",
                "convert_epochs_to_steps": true,
                "schedulers": [
                    {
                        "name": "LinearLR",
                        "kwargs": {
                            "start_factor": 1e-8,
                            "total_iters": 5
                        }
                    },
                    {
                        "name": "CosineAnnealingLR",
                        "kwargs": {
                            "T_max": 85,
                            "eta_min": 0
                        }
                    }
                ],
                "milestones": [5]
            }
        }
    }
}
