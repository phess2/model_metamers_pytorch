{
    "model_name": "lipsresnet",
    "hparams": {
        "num_classes": 1000,
        "w_max": 2.0,
        "projection": "spectral_normalize",
        "max_epochs": 10,
        "val_check_interval": 0.25,
        "block_type": "basic",
        "layer_sizes": [2, 2, 2, 2],
        "zero_init_residual": false
    },
    "data_settings": {
        "batch_size": 512,
        "pin_memory": false
    },
    "optim_settings": {
        "mult_optimizers": false,
        "optimizer": {
            "name": "AdamW",
            "kwargs": {
                "lr": 0.0001,
                "betas": [0.9, 0.999],
                "eps": 1e-8,
                "weight_decay": 0.0001
            }
        }
    }
}
