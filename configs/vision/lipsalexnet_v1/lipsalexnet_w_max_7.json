{
    "model_name": "lipsalexnet",
    "hparams": {
        "num_classes": 1000,
        "w_max": 7.0,
        "projection": "spectral_normalize",
        "max_epochs": 50,
        "val_check_interval": 0.25
    },
    "data_settings": {
        "batch_size": 512,
        "pin_memory": false
    },
    "optim_settings": {
        "mult_optimizers": false,
        "optimizer": {"name": "AdamW", 
            "kwargs": {
                "lr": 0.0001,
                "betas": [0.9, 0.999],
                "eps": 1e-8,
                "weight_decay": 0.0001
            }
        }
    }
}
